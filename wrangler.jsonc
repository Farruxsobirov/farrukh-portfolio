{
  // Cloudflare Worker that serves the static Next.js export from ./out
  // Build command: npm run build   Deploy command: npx wrangler deploy
  "name": "farrukh-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Paths without a language prefix ("/", "/logvia/") and the contact API go to the
    // Worker first; everything under /en, /uz, /ru and the build files is served directly.
    "run_worker_first": ["/*", "!/_next/*", "!/en/*", "!/uz/*", "!/ru/*", "!/projects/*"]
  },
  "observability": { "enabled": true }
}
